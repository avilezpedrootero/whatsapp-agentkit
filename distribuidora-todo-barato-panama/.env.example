# Elegance — plantilla de variables (SIN secretos, esta SI puede ir a GitHub)
# Copia a ".env" y pega tus credenciales ahi. El archivo .env NUNCA se sube a GitHub.

# ── Shopify (app creada en el Dev Dashboard) ───────────────
# Dominio interno de la tienda, formato: mi-tienda.myshopify.com (NO el dominio personalizado)
SHOPIFY_STORE_DOMAIN=
# Dev Dashboard -> tu app -> Settings -> Credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Opcional: solo si tu app entrega un token directo (empieza con shpat_)
SHOPIFY_ACCESS_TOKEN=
# Version de la Admin API (usa la estable mas reciente que veas en Shopify)
SHOPIFY_API_VERSION=2026-07
# Permisos (scopes) que debe tener la app instalada
SHOPIFY_SCOPES=read_products,write_products,read_files,write_files,read_themes,write_themes,read_content,write_content

# ── Generacion de imagenes y video ─────────────────────────
# Elige UN proveedor: gemini | higgsfield
MEDIA_PROVIDER=gemini

# ── Gemini (Nano Banana Pro y Veo) ─────────────────────────
# Llave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Imagenes (elige una):
#   gemini-3-pro-image-preview  -> Nano Banana Pro (mejor calidad, texto legible en imagen)
#   gemini-3.1-flash-image-preview -> Nano Banana 2 (rapido, mas barato)
#   gemini-2.5-flash-image      -> Nano Banana original
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# Video para anuncios (verifica el ID vigente en ai.google.dev/gemini-api/docs/video)
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

# ── Higgsfield ─────────────────────────────────────────────
# Llave en https://console.higgsfield.ai (ID + secret, el secret se muestra una sola vez)
HF_API_KEY=
HF_API_SECRET=
# Modelos de imagen de ejemplo: Soul 2, Soul Cinema, Marketing Studio Image, Ideogram, Recraft, Qwen.
# Copia el ID exacto desde el catalogo de modelos de la consola.
HIGGSFIELD_IMAGE_MODEL=
HIGGSFIELD_VIDEO_MODEL=

# ── Uso ────────────────────────────────────────────────────
# landing | meta_ads | tiktok_ads (referencia de formatos que usaremos)
# Landing 16:9 y 1:1 | Meta feed 1:1 y 4:5, Stories/Reels 9:16 | TikTok 9:16
OUTPUT_DIR=./output
